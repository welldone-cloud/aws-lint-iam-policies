{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowAssumingMemberAccountsRoleSpecifiedInArgument",
            "Effect": "Allow",
            "Action": "sts:AssumeRole",
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "aws:ResourceOrgID": "${aws:PrincipalOrgID}",
                    "sts:RoleSessionName": "aws-lint-iam-policies"
                }
            }
        },
        {
            "Sid": "AllowLintingPolicies",
            "Effect": "Allow",
            "Action": [
                "access-analyzer:Check*",
                "access-analyzer:Validate*",
                "acm-pca:Get*",
                "acm-pca:List*",
                "appmesh:Get*",
                "appsync:Get*",
                "aws-marketplace:Get*",
                "aws-marketplace:List*",
                "backup:Get*",
                "backup:List*",
                "bedrock:Get*",
                "billing:Get*",
                "cloudhsm:Get*",
                "cloudtrail:Get*",
                "cloudtrail:List*",
                "codeartifact:Get*",
                "codeartifact:List*",
                "codebuild:Get*",
                "codebuild:List*",
                "codeconnections:Get*",
                "datazone:Get*",
                "dynamodb:Describe*",
                "dynamodb:Get*",
                "dynamodb:List*",
                "ec2:Describe*",
                "ec2:Get*",
                "ecr:Describe*",
                "ecr:Get*",
                "ecr-public:Describe*",
                "ecr-public:Get*",
                "elasticfilesystem:Describe*",
                "elasticloadbalancing:Get*",
                "es:Describe*",
                "es:List*",
                "events:List*",
                "fsx:Get*",
                "glacier:Get*",
                "glacier:List*",
                "glue:Get*",
                "iam:Get*",
                "iam:List*",
                "imagebuilder:Get*",
                "imagebuilder:List*",
                "iot:Get*",
                "iot:List*",
                "kafka:Get*",
                "kafka:List*",
                "kinesis:Get*",
                "kinesis:List*",
                "kms:Describe*",
                "kms:Get*",
                "kms:List*",
                "lambda:Get*",
                "lambda:List*",
                "lex:Describe*",
                "lex:List*",
                "logs:Describe*",
                "logs:Get*",
                "mediastore:Get*",
                "mediastore:List*",
                "network-firewall:Describe*",
                "network-firewall:List*",
                "networkmanager:Get*",
                "oam:Get*",
                "oam:List*",
                "odb:Get*",
                "organizations:Describe*",
                "organizations:List*",
                "ram:Get*",
                "ram:List*",
                "redshift-serverless:Get*",
                "redshift-serverless:List*",
                "refactor-spaces:Get*",
                "refactor-spaces:List*",
                "rekognition:Describe*",
                "rekognition:List*",
                "resource-explorer-2:Get*",
                "resource-groups:Get*",
                "route53-recovery-control-config:Get*",
                "route53profiles:Get*",
                "route53resolver:Get*",
                "route53resolver:List*",
                "rum:Get*",
                "rum:List*",
                "s3-outposts:Get*",
                "s3-outposts:List*",
                "s3:Get*",
                "s3:List*",
                "s3express:Get*",
                "s3express:List*",
                "s3tables:Get*",
                "s3tables:List*",
                "s3vectors:Get*",
                "s3vectors:List*",
                "sagemaker:Get*",
                "sagemaker:List*",
                "schemas:Get*",
                "schemas:List*",
                "secretsmanager:Get*",
                "secretsmanager:List*",
                "securityhub:Describe*",
                "securityhub:List*",
                "servicecatalog:Get*",
                "ses:Get*",
                "ses:List*",
                "signin:Get*",
                "sms-voice:Get*",
                "sns:Get*",
                "sns:List*",
                "sqs:Get*",
                "sqs:List*",
                "ssm:Describe*",
                "ssm:Get*",
                "ssm-contacts:Get*",
                "ssm-contacts:List*",
                "ssm-incidents:Get*",
                "ssm-incidents:List*",
                "sso:Describe*",
                "sso:Get*",
                "sso:List*",
                "vpc-lattice:Get*",
                "vpc-lattice:List*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "AllowLintingPoliciesForAPIGatewayRESTAPIs",
            "Effect": "Allow",
            "Action": "apigateway:GET",
            "Resource": "*"
        }
    ]
}